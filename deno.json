{
  "name": "@ghostflyby/worker-actor",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "publish": {
    "exclude": [
      ".github/",
      ".gitignore",
      ".zcode/",
      "DESIGN.md",
      "OWNERSHIP.md",
      "PLUGIN-SYSTEM.md",
      "deno.lock",
      "examples/",
      "test_fixtures/",
      "**/*_test.ts"
    ]
  },
  "tasks": {
    "demo": "deno run --allow-read examples/calculator/main.ts",
    "demo:ref": "deno run --allow-read examples/remote_ref/main.ts",
    "test": "deno test --allow-read"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "exports": {
    ".": "./mod.ts",
    "./codec": "./codec.ts",
    "./codecs": "./codecs.ts"
  }
}
